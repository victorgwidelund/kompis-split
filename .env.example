# Local development only. Never commit a real .env file.
PORT=8787
APP_PASSWORD=replace-with-a-long-random-setup-password
COOKIE_SECRET=replace-with-at-least-32-random-bytes
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
COOKIE_SECURE=false
TRUST_PROXY=false
SESSION_DAYS=30
BACKUP_RETENTION_DAYS=14
RECEIPT_INFERENCE_TIMEOUT_MS=15000
OCR_INTRA_OP_THREADS=8
OCR_QUEUE_CAPACITY=4
OCR_MEMORY_LIMIT=1g
OCR_CPU_LIMIT=8
# Tesseract is an outage fallback, not the normal production path.
RECEIPT_OCR_WORKERS=1
