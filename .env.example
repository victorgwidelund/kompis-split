# Local development only. Never commit a real .env file.
PORT=8787
APP_PASSWORD=replace-with-a-long-random-setup-password
COOKIE_SECRET=replace-with-at-least-32-random-bytes
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
COOKIE_SECURE=false
TRUST_PROXY=false
SESSION_DAYS=30
BACKUP_RETENTION_DAYS=14
PADDLEOCR_TIMEOUT_MS=60000
PADDLEOCR_MAX_TOKENS=512
PADDLEOCR_ACCURATE_RETRY=true
PADDLEOCR_PARALLEL=2
RECEIPT_OCR_WORKERS=2
# Off by default (receipt content is never logged unless you turn this on). Set to true only
# temporarily while diagnosing a specific bad scan, then unset it again.
RECEIPT_OCR_DEBUG_LOG=false
