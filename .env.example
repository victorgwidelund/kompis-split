# Local development only. Never commit a real .env file.
PORT=8787
APP_PASSWORD=replace-with-a-long-random-setup-password
COOKIE_SECRET=replace-with-at-least-32-random-bytes
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
COOKIE_SECURE=false
TRUST_PROXY=false
SESSION_DAYS=30
BACKUP_RETENTION_DAYS=14
RECEIPT_INFERENCE_TIMEOUT_MS=15000
OCR_INTRA_OP_THREADS=8
OCR_QUEUE_CAPACITY=4
OCR_MEMORY_LIMIT=1g
OCR_CPU_LIMIT=8
# Tesseract is an outage fallback, not the normal production path.
RECEIPT_OCR_WORKERS=1
# Web Push. Generate once with: node -e "console.log(require('web-push').generateVAPIDKeys())"
# Leave both unset to keep push notifications fully disabled (no crash, the toggle just stays hidden).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:replace-with-your-admin-email
