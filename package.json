{
  "name": "kompis-split",
  "version": "1.20.3",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm build:server && pnpm build:frontend",
    "build:server": "tsc -p tsconfig.build.json",
    "build:frontend": "vite build --config frontend/vite.config.ts",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "dev:frontend": "vite --config frontend/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc -p frontend/tsconfig.json --noEmit",
    "check": "pnpm typecheck && pnpm lint",
    "lint": "eslint src frontend/src frontend/vite.config.ts",
    "test": "pnpm build && node --test tests/*.test.mjs && vitest run --config frontend/vitest.config.ts"
  },
  "dependencies": {
    "@tesseract.js-data/swe": "1.0.0",
    "pg": "8.16.3",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.3",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@eslint/js": "9.39.5",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.0.18"
  }
}
